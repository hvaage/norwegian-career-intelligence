# NAV pam-stilling-feed (technical test / future ingestion)
# Swagger: https://pam-stilling-feed.ekstern.dev.nav.no/swagger
# Docs: https://navikt.github.io/pam-stilling-feed/

# Base URL for the feed API (defaults in code to production if unset)
NAV_FEED_BASE_URL=https://pam-stilling-feed.nav.no

# Optional: private Bearer token when available.
# If omitted on the production host, scripts/test_nav_feed.py fetches NAV's
# current public token from /api/publicToken for smoke testing.
# NAV_FEED_TOKEN=

# Set to 0 to disable public-token fallback.
NAV_FEED_USE_PUBLIC_TOKEN=1
