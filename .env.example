# NAV pam-stilling-feed (technical test / future ingestion)
# Docs: https://navikt.github.io/pam-stilling-feed/
# Prod feed: https://pam-stilling-feed.nav.no/api/v1/feed

# Base URL for the feed API (defaults in code to production if unset)
NAV_FEED_BASE_URL=https://pam-stilling-feed.nav.no

# Optional: private Bearer token when available.
# If omitted on the production host, scripts/test_nav_feed.py fetches NAV's
# current public token from /api/publicToken for smoke testing.
# NAV_FEED_TOKEN=

# Set to 0 to disable public-token fallback.
NAV_FEED_USE_PUBLIC_TOKEN=1

# Supabase (Edge Function test page public/nav-feed-test.html)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=  # Edge Functions + Vault cron (never expose in frontend)

# NAV scheduled sync (pg_cron): store service role in Vault once (SQL editor):
# SELECT vault.create_secret('<SERVICE_ROLE_KEY>', 'nav_feed_service_role_key', 'nav-feed cron');
# sb_secret_* keys use apikey header; legacy eyJ keys use Bearer + apikey. nav-feed has verify_jwt=false.
